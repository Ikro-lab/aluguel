# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Resend (https://resend.com) — envia o e-mail de notificação quando alguém
# agenda pela página pública /agendar. Nunca use o prefixo NEXT_PUBLIC_ aqui,
# essas chaves só rodam no servidor.
RESEND_API_KEY=sua-api-key-do-resend
LOJISTA_EMAIL=email-do-lojista@exemplo.com
